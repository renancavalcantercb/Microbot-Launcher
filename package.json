{
  "name": "microbot-launcher",
  "version": "3.2.10",
  "description": "Launcher for the Microbot Cut client",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env DEBUG=true electron .",
    "dev:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-plugin-staging.ps1",
    "dev:walker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-plugin-staging.ps1 -PluginDevelopment",
    "dev:guardian": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-plugin-staging.ps1 -PluginDevelopment -PluginJar ..\\microbot-cut-plugins\\plugins\\remote-guardian\\build\\libs\\remote-guardian-0.1.1.jar -PluginDevelopmentJarName RemoteControlPlugin.jar",
    "dev:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-product-production.ps1",
    "dev:plugin-staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-plugin-staging.ps1",
    "dev:mock": "cross-env DEBUG=true MOCK_AUTH=1 MOCK_USERS='demo@microbot.com:DemoPassword123,test@example.com:TestPassword123' electron .",
    "start": "electron-forge start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "product:sync": "node scripts/sync-product-config.js",
    "release": "npm run product:sync && electron-builder --publish never",
    "release:windows:unsigned": "npm run product:sync && electron-builder --win nsis --publish never",
    "release:windows:production": "npm run product:sync && node scripts/build-windows-production.js",
    "release:key:generate": "node scripts/generate-release-signing-key.js",
    "release:manifest:sign": "node scripts/sign-release-manifest.js",
    "release:client": "node scripts/publish-client-release.js",
    "linux": "electron-builder --linux",
    "mac": "electron-builder --mac"
  },
  "author": "Mocrosoft",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.15",
    "applicationinsights": "^2.9.6",
    "axios": "^1.7.2",
    "cheerio": "1.1.2",
    "detect-browsers": "^6.1.0",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.1.8",
    "patchright": "^1.52.5",
    "update-electron-app": "^3.0.0"
  },
  "build": {
    "asar": "true",
    "appId": "com.microbotcut.launcher",
    "productName": "Microbot Cut Launcher",
    "files": [
      "main.js",
      "renderer.js",
      "preload.js",
      "package.json",
      "!**/*.map",
      "images/**",
      "libs/**",
      "index.html",
      "css/**",
      "build/READ THIS BEFORE INSTALL.html",
      "product-config.js"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "images/microbot_cut.png"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "default",
      "icon": "images/microbot_cut.png"
    },
    "dmg": {
      "icon": "images/microbot_cut.png",
      "background": "images/dmg-background.png",
      "title": "${productName} Installer",
      "iconSize": 108,
      "contents": [
        {
          "x": 530,
          "y": 192,
          "type": "file",
          "path": "./build/READ THIS BEFORE INSTALL.html"
        },
        {
          "x": 200,
          "y": 400,
          "type": "file"
        },
        {
          "x": 730,
          "y": 495,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ],
      "icon": "images/microbot_cut.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Microbot Cut Launcher"
    }
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  }
}
